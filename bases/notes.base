# LearningOS note shelves (installed by obsidian-ui/install.py; the canonical
# data lives in each note's frontmatter — this file is pure presentation).
filters:
  and:
    - 'file.path.startsWith("knowledge/notes/")'
    - 'note.type == "note"'
properties:
  note.title:
    displayName: Title
  note.state:
    displayName: State
  note.role:
    displayName: Role
  note.semantic_review:
    displayName: Semantic review
  file.folder:
    displayName: Domain folder
  file.mtime:
    displayName: Modified
views:
  - type: table
    name: All notes
    order:
      - file.name
      - note.title
      - note.state
      - note.role
      - note.semantic_review
      - file.folder
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: Recently changed
    limit: 20
    order:
      - file.name
      - note.state
      - note.role
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: Needs semantic review
    filters:
      and:
        - 'note.semantic_review != "user-reviewed"'
    order:
      - file.name
      - note.state
      - note.role
      - note.semantic_review
      - file.mtime
    sort:
      - property: file.mtime
        direction: ASC
  - type: table
    name: Rough or evolving
    filters:
      and:
        - 'note.state == "rough" || note.state == "evolving"'
    order:
      - file.name
      - note.state
      - note.role
      - file.mtime
  - type: table
    name: Exam artifacts
    filters:
      and:
        - 'note.role == "exercise-bank" || note.role == "mock-exam"'
    order:
      - file.name
      - note.role
      - note.state
      - file.folder
  - type: table
    name: User-reviewed
    filters:
      and:
        - 'note.semantic_review == "user-reviewed"'
    order:
      - file.name
      - note.state
      - note.semantic_review
      - file.folder
  - type: table
    name: By domain
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - note.state
      - note.role
