# The Garden through Bases: free-form ideas gestating in knowledge/garden/
# (no frontmatter by design — file properties only). Oldest first = ripest
# for the harvest-or-prune call. The Nebula (generated/nebula.md) stays the
# canonical-side lens; this is just a friendlier surface over the same files.
filters:
  and:
    - 'file.path.startsWith("knowledge/garden/")'
    - 'file.ext == "md"'
#
# VIEW ORDER MATTERS. `table` is first because it is the view type every other
# shelf here uses and the one Bases has supported longest. `cards` is newer, and
# when this file led with it the Garden was the only broken shelf in the vault
# while notes.base and workspaces.base — both table-only — worked. A base opens
# on its first view, so leading with the fragile one takes the whole shelf down;
# leading with the sturdy one degrades to "cards tab looks wrong" at worst.
# Fixed 2026-08-08.
views:
  - type: table
    name: All garden notes
    order:
      - file.name
      - file.mtime
      - file.size
    sort:
      - property: file.mtime
        direction: ASC
  - type: cards
    name: Ripest first
    sort:
      - property: file.mtime
        direction: ASC
