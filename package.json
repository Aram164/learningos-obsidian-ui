{
  "name": "learningos-ui",
  "private": true,
  "version": "2.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:styles": "node build-styles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:source-graph": "node scripts/check-source-graph.mjs",
    "check:code": "npm run typecheck && npm run check:source-graph && npm run test:manifest-store-indexes && npm run test:atlas-graph && npm run test:library-finder && npm run test:trace-context && npm run test:operations",
    "contract:check": "node scripts/check-contract.mjs",
    "contract:generate": "node scripts/generate-contract.mjs --bundle ../repository/generated/contract-prototype/manifest-v13.bundle.json --meta ../repository/generated/contract-prototype/manifest-v13.meta.json",
    "typecheck:contract-prototype": "tsc -p tsconfig.contract-prototype.json --noEmit",
    "contract:diff-prototype": "node scripts/diff-contract-prototype.mjs",
    "test:ui": "node tests/test-dashboard.js && node tests/test-ai-actions.js",
    "test": "npm run build && npm run check:code && npm run typecheck:contracts && npm run contract:check && npm run test:installer && npm run test:modules && npm run test:ui && npm run test:live-app-check && npm run test:ci-policy",
    "check": "npm run test && node scripts/check-host-surface.mjs && node scripts/check-build.mjs",
    "build:info": "node scripts/print-build-info.mjs",
    "install:status": "node scripts/check-install-current.mjs",
    "typecheck:contracts": "tsc -p tsconfig.contract.json --noEmit",
    "test:installer": "python3 tests/test_installer.py",
    "test:modules": "node tests/test-runtime-modules.js",
    "test:manifest-store-indexes": "node tests/test-manifest-store-indexes.js",
    "test:atlas-graph": "node tests/test-atlas-graph.js",
    "test:live-app-check": "node tests/test-live-app-check.js",
    "test:ci-policy": "node tests/test-ci-policy.js && node tests/test-sorting.js",
    "check:live": "node scripts/check-live-app.mjs",
    "test:library-finder": "node tests/test-library-finder.js",
    "test:trace-context": "node tests/test-trace-context.js",
    "test:operations": "node tests/test-operations.js"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.25.0",
    "typescript": "5.8.3"
  }
}
