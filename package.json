{
  "name": "learningos-ui",
  "private": true,
  "version": "2.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "contract:check": "node scripts/check-contract.mjs",
    "test:ui": "node tests/test-dashboard.js && node tests/test-ai-actions.js",
    "test": "npm run build && npm run typecheck && npm run typecheck:contracts && npm run contract:check && npm run test:modules && npm run test:ui",
    "check": "npm run test && node scripts/check-build.mjs",
    "build:info": "node scripts/print-build-info.mjs",
    "typecheck:contracts": "tsc -p tsconfig.contract.json --noEmit",
    "test:modules": "node tests/test-runtime-modules.js"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "esbuild": "^0.25.0"
  }
}
